{
  "manifest_version": 3,
  "name": "Voice Fixer Assistant",
  "version": "1.0",
  "description": "Умная голосовая диктовка с ИИ Gemini. Hotkeys: Ctrl/Cmd+Shift+X (запуск), Пробел (стоп), Esc (отмена).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voice Fixer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Начать диктовку (Voice Fixer)"
    }
  }
}
